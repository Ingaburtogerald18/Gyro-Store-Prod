# Nunca copiar dependencias del host a la imagen: son binarios de Windows y
# romperían `sharp` (y otros módulos nativos) en Linux. Se reinstalan dentro.
node_modules
**/node_modules

# Salida de build del frontend (se regenera en el build de la imagen).
frontend/build
frontend/.cache

# Temporales y secretos locales — no deben entrar a la imagen.
tmp
*.log
.env
.env.*
