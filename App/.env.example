# Plantilla de variables de entorno. Copiala a App/.env (o al archivo que indique
# GYRO_ENV_FILE) y completá los valores. Detalle de cada una: Docs/02-Arquitectura.md §9.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=

# Supabase (Project Settings → API). Obligatorias.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: verifica el token localmente.
SUPABASE_JWT_SECRET=

# Personal
INTERNAL_DOMAIN=gyrostorenic.com
# Obligatoria en producción: el global_admin.
PROTECTED_ADMIN_EMAIL=
# Opcional: título de las páginas.
BRAND_NAME=

# Cloudflare R2 (imágenes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Sin barra final.
R2_PUBLIC_URL=
# Opcional: si falta se arma con R2_ACCOUNT_ID.
R2_ENDPOINT=

# SharePoint (comprobantes). Opcionales: sin todas, el módulo queda apagado.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SPO_SITE_ID=
SPO_DRIVE_ID=
# Solo para npm run spo:ids.
SPO_SITE_URL=
