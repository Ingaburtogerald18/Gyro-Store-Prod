{
  "name": "gyro-store",
  "version": "2.0.0",
  "description": "Gyro Store v2 — backend Express (TS/ESM) sobre Supabase",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "seed:dev": "tsx scripts/seed-catalog.dev.mts",
    "spo:ids": "tsx scripts/spo-ids.ts",
    "spo:status": "tsx scripts/spo-drain.ts --status",
    "spo:drain": "tsx scripts/spo-drain.ts",
    "spo:pdf": "tsx scripts/spo-comprobante.ts",
    "test": "tsx --test tests/analytics.test.ts tests/pagination.test.ts tests/orders.test.ts tests/orderTransaction.test.ts tests/variantMappings.test.ts tests/migration0026.test.ts tests/templateVariants.test.ts",
    "checkout:check": "tsx scripts/check-public-checkout.mts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ingaburtogerald18/Gyro-Store.git"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@remix-run/node": "^2.8.1",
    "@supabase/supabase-js": "^2.111.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.6",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
